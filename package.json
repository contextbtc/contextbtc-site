{
	"name": "contextbtc-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "ContextBTC website - A project to build Bitcoin tools on top of https://github.com/contextvm",
	"author": "Karliatto <karliatto@protonmail.com>",
	"license": "LGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/karliatto/contextbtc-site"
	},
	"homepage": "https://contextbtc.org",
	"keywords": [
		"bitcoin",
		"contextvm",
		"contextbtc",
		"tools",
		"infrastructure",
		"node",
		"tools"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:wasm": "wasm-pack build wallet-wasm --target web --out-dir ../src/lib/wasm/bdk --out-name bdk",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^9.39.4",
		"@lucide/svelte": "^0.562.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "^1.3.14",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^16.5.0",
		"prettier": "3.7.4",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.0",
		"svelte-check": "^4.4.5",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.2",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@contextvm/mcp-sdk": "^1.30.0",
		"@contextvm/sdk": "^0.13.6",
		"@tanstack/svelte-query": "^5.90.2",
		"ajv": "^8.20.0",
		"applesauce-accounts": "^6",
		"applesauce-core": "^6",
		"applesauce-loaders": "^6",
		"applesauce-relay": "^6",
		"applesauce-signers": "^6",
		"dompurify": "^3.3.3",
		"lean-qr": "^2.7.1",
		"marked": "^17.0.5",
		"mode-watcher": "^1.1.0",
		"nostr-tools": "^2.23.3",
		"openai": "^6.38.0",
		"rxjs": "^7.8.2"
	}
}
