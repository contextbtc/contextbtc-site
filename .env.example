# Required: ContextVM Bitcoin Core server used by /chat and /wallet (hex pubkey, npub or nprofile).
# VITE_-prefixed vars are inlined into the public bundle — never put a secret here.
VITE_CONTEXTBTC_SERVER_PUBKEY=

# Required: ContextVM relays used by /chat, /wallet and the MCP clients.
# Comma-separated ws:// or wss:// URLs.
VITE_CONTEXTBTC_RELAYS=ws://localhost:10547

# Required: relays to fetch profiles from and publish profile metadata to on login.
# Comma-separated ws:// or wss:// URLs.
VITE_METADATA_RELAYS=wss://purplepag.es/,wss://nos.lol,wss://relay.damus.io

# Optional: ContextVM electrs server (crates/electrs-server) for the /wallet page's Electrum sync.
# Without it, only the Bitcoin RPC sync is usable.
VITE_CONTEXTBTC_ELECTRS_PUBKEY=

# Optional: Cashu mint used for Lightning top-ups of the in-browser ecash wallet
# that pays Routstr completions. Must be a mint the Routstr node accepts (see /v1/info).
# Defaults to https://mint.minibits.cash/Bitcoin.
VITE_CASHU_MINT_URL=
