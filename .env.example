# Required: ContextVM Bitcoin Core server used by /chat and /wallet (hex pubkey, npub or nprofile).
# VITE_-prefixed vars are inlined into the public bundle — never put a secret here.
VITE_CONTEXTBTC_SERVER_PUBKEY=

# Required: ContextVM relays used by /chat, /wallet and the MCP clients.
# Comma-separated ws:// or wss:// URLs.
VITE_CONTEXTBTC_RELAYS=ws://localhost:10547

# Required: relays to fetch profiles from and publish profile metadata to on login.
# Comma-separated ws:// or wss:// URLs.
VITE_METADATA_RELAYS=wss://purplepag.es/,wss://nos.lol,wss://relay.damus.io

# Optional: ContextVM electrs server (crates/electrs-server) for the /wallet page's Electrum sync.
# Without it, only the Bitcoin RPC sync is usable.
VITE_CONTEXTBTC_ELECTRS_PUBKEY=

# Optional: default watch-only descriptor pair shown on /wallet, as "<external> <internal>"
# (one space between them; public keys only). MAINNET is used for mainnet, TESTNET for
# testnet3, testnet4, signet and regtest. Without one, the user enters descriptors on the page.
# all seed: "all all all all all all all all all all all all" for demo
VITE_DEFAULT_DESCRIPTORS_MAINNET="tr([5c9e228d/86'/0'/0']xpub6Bw885JisRbcKmowfBvMmCxaFHodKn1VpmRmctmJJoM8D4DzyP4qJv8ZdD9V9r3SSGjmK2KJEDnvLH6f1Q4HrobEvnCeKydNvf1eir3RHZk/0/*)#d8jj22qr tr([5c9e228d/86'/0'/0']xpub6Bw885JisRbcKmowfBvMmCxaFHodKn1VpmRmctmJJoM8D4DzyP4qJv8ZdD9V9r3SSGjmK2KJEDnvLH6f1Q4HrobEvnCeKydNvf1eir3RHZk/1/*)#unhnhlsm"
VITE_DEFAULT_DESCRIPTORS_TESTNET="tr([12071a7c/86'/1'/0']tpubDCaLkqfh67Qr7ZuRrUNrCYQ54sMjHfsJ4yQSGb3aBr1yqt3yXpamRBUwnGSnyNnxQYu7rqeBiPfw3mjBcFNX4ky2vhjj9bDrGstkfUbLB9T/0/*)#z3x5097m tr([12071a7c/86'/1'/0']tpubDCaLkqfh67Qr7ZuRrUNrCYQ54sMjHfsJ4yQSGb3aBr1yqt3yXpamRBUwnGSnyNnxQYu7rqeBiPfw3mjBcFNX4ky2vhjj9bDrGstkfUbLB9T/1/*)#n9r4jswr"

# Optional: Cashu mint used for Lightning top-ups of the in-browser ecash wallet
# that pays Routstr completions. Must be a mint the Routstr node accepts (see /v1/info).
# Defaults to https://mint.minibits.cash/Bitcoin.
VITE_CASHU_MINT_URL=
